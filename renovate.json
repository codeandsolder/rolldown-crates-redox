{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Track the build toolchain only; do not auto-update Cargo MSRV floors",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "Rust toolchain"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "(?m)^channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "Rust toolchain",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ]
}
