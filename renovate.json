{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet",
    "github>codeandsolder/ci-workflows:renovate-native-automerge"
  ],
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Update crates sharing version-specific Rust types together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "oxc_allocator",
        "oxc_ast",
        "oxc_parser",
        "oxc_span",
        "oxc_syntax"
      ],
      "groupName": "Oxc core crates",
      "groupSlug": "oxc-core-crates"
    }
  ]
}
